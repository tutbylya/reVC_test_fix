+namespace {
+std::string ReVCModNameUtf8(const std::string& name)
+{
+    wchar_t wide[MAX_PATH];
+    char utf8[MAX_PATH * 4];
+    const int wideLength = MultiByteToWideChar(CP_ACP, MB_ERR_INVALID_CHARS, name.c_str(), -1, wide, MAX_PATH);
+    if (!wideLength) return {};
+    const int length = WideCharToMultiByte(CP_UTF8, WC_ERR_INVALID_CHARS, wide, wideLength,
+                                         utf8, sizeof(utf8), nullptr, nullptr);
+    return length ? std::string(utf8, length - 1) : std::string{};
+}
+
+bool ReadReVCDisabledMods(std::set<std::string>& disabled)
+{
+    // The game's directory is current at loader startup. Snapshot once: the
+    // hidden file is not a profile and the watcher must never apply it live.
+    const DWORD folder = GetFileAttributesW(L"modloader");
+    if (folder == INVALID_FILE_ATTRIBUTES || (folder & FILE_ATTRIBUTE_REPARSE_POINT)) return false;
+    const HANDLE file = CreateFileW(L"modloader\\.revc-disabled", GENERIC_READ, FILE_SHARE_READ | FILE_SHARE_DELETE,
+                                   nullptr, OPEN_EXISTING, FILE_FLAG_OPEN_REPARSE_POINT, nullptr);
+    if (file == INVALID_HANDLE_VALUE) return GetLastError() == ERROR_FILE_NOT_FOUND;
+    BY_HANDLE_FILE_INFORMATION info = {};
+    char bytes[ModMenu::MaxStateBytes];
+    LARGE_INTEGER length = {};
+    DWORD size = 0;
+    const bool read = GetFileType(file) == FILE_TYPE_DISK && GetFileInformationByHandle(file, &info) &&
+        !(info.dwFileAttributes & (FILE_ATTRIBUTE_DIRECTORY | FILE_ATTRIBUTE_REPARSE_POINT)) &&
+        GetFileSizeEx(file, &length) && length.QuadPart >= 0 && length.QuadPart <= sizeof(bytes) &&
+        ReadFile(file, bytes, static_cast<DWORD>(length.QuadPart), &size, nullptr) && size == length.QuadPart;
+    CloseHandle(file);
+    if (!read) return false;
+    std::istringstream stream{std::string(bytes, size)};
+    return ModMenu::ParseDisabled(stream, disabled);
+}
+}
+
+void Loader::ReadReVCMenuState()
+{
+    this->revcMenuDisabled.clear();
+    this->revcMenuPolicyValid = ReadReVCDisabledMods(this->revcMenuDisabled);
+    if (!this->revcMenuPolicyValid) Log("Cannot read modloader/.revc-disabled safely; resource mods will not be installed.");
+}
+
+bool Loader::IsReVCMenuDisabled(const std::string& folderName) const
+{
+    if (this->game_id != MODLOADER_GAME_REVC) return false;
+    return !this->revcMenuPolicyValid ||
+        this->revcMenuDisabled.count(ModMenu::NormalizeId(ReVCModNameUtf8(folderName))) != 0;
+}
+
+bool Loader::VisitReVCMods(ReVCModVisitor visitor, void* context)
+{
+    if (!visitor) return false;
+    if (!this->bRunning) return true; // No mod directory, no installed resources.
+    if (this->game_id != MODLOADER_GAME_REVC) return false;
+    // Called on the host main thread, not from the file-watcher thread. Only
+    // installed resources count, not the plug-ins or empty mod directories.
+    auto mods = this->mods.GetModsByName();
+    if (mods.size() > 4096) return false;
+    for (const ModInformation& mod : mods)
+    {
+        const std::string label = ReVCModNameUtf8(mod.menu_name);
+        const std::string id = ModMenu::NormalizeId(label);
+        const bool installed = std::any_of(mod.files.begin(), mod.files.end(),
+            [](const decltype(mod.files)::value_type& entry) { return entry.second.IsInstalled(); });
+        const bool blocked = !this->revcMenuPolicyValid || !ModMenu::IsValidId(id) ||
+            this->mods.Profile().IsIgnoring() || this->mods.Profile().IsIgnored(mod.GetName());
+        const bool disabled = this->revcMenuDisabled.count(id) != 0;
+        visitor(context, id.c_str(), label.c_str(),
+                (installed ? 1u : 0u) | (blocked ? 2u : 0u) | (disabled ? 4u : 0u));
+    }
+    return true;
+}
+
+// Optional API: old game builds and old DLLs retain the existing bridge ABI.
+extern "C" int __declspec(dllexport) __cdecl modloader_VisitReVCMods(Loader::ReVCModVisitor visitor, void* context)
+{
+    try { return loader.VisitReVCMods(visitor, context) ? 1 : 0; }
+    catch (...) { return 0; }
+}
