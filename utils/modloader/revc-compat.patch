diff --git a/src/plugins/gta3/std.stream/backend.cpp b/src/plugins/gta3/std.stream/backend.cpp
index 0f23aef..b986f77 100644
--- a/src/plugins/gta3/std.stream/backend.cpp
+++ b/src/plugins/gta3/std.stream/backend.cpp
@@ -6,6 +6,7 @@
  */
 #include <stdinc.hpp>
 #include "streaming.hpp"
+#include <atomic>
 using namespace modloader;
 
 extern "C"
@@ -135,6 +136,23 @@ uint32_t CdStreamSync( int32_t streamID )
  *  Streaming thread
  *      This thread reads pieces from cd images and in mod loader on disk files
  */
+static std::atomic<bool> reVCStreamStopRequested(false);
+
+static void PrepareREVCStreamThread()
+{
+    // Called by the host before CreateThread, not from the worker: an early
+    // shutdown request must never be overwritten when the worker is scheduled.
+    reVCStreamStopRequested.store(false, std::memory_order_release);
+}
+
+static void StopREVCStreamThread()
+{
+    reVCStreamStopRequested.store(true, std::memory_order_release);
+    const HANDLE semaphore = *modloader_reVC->reVC_addr_table->p_gCdStreamSema;
+    if (semaphore)
+        ReleaseSemaphore(semaphore, 1, nullptr);
+}
+
 int __stdcall CdStreamThread()
 {
     HANDLE* pSemaphore = nullptr;
@@ -163,7 +181,11 @@ int __stdcall CdStreamThread()
         CAbstractStreaming::AbctFileHandle* sfile = nullptr;
         
         // Wait until there's something to be loaded...
-        WaitForSingleObject(*pSemaphore, -1);
+        if (WaitForSingleObject(*pSemaphore, INFINITE) != WAIT_OBJECT_0)
+            break;
+        if (plugin_ptr->loader->game_id == MODLOADER_GAME_REVC &&
+            reVCStreamStopRequested.load(std::memory_order_acquire))
+            break;
         
         // Take the stream index from the queue
         int i = GetFirstInQueue(pQueue);
@@ -595,7 +617,12 @@ void CAbstractStreaming::Patch()
         if(game_id == MODLOADER_GAME_RE3)
             modloader_re3->callback_table->CdStreamThread = +[] { CdStreamThread(); };
         else if(game_id == MODLOADER_GAME_REVC)
+        {
+            reVCStreamStopRequested.store(false, std::memory_order_release);
+            modloader_reVC->callback_table->StopCdStreamThread = StopREVCStreamThread;
+            modloader_reVC->callback_table->PrepareCdStreamThread = PrepareREVCStreamThread;
             modloader_reVC->callback_table->CdStreamThread = +[] { CdStreamThread(); };
+        }
         else
             MakeJMP(0x406560, raw_ptr(CdStreamThread));
 
