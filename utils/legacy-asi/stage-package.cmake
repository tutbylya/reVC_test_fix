cmake_minimum_required(VERSION 3.14)

# The defaults are data only. Never replace a user's opt-in manifest while
# rebuilding, installing, or collecting a CI artifact.
if(NOT DEFINED REVC_PACKAGE_DIRECTORY OR REVC_PACKAGE_DIRECTORY STREQUAL "")
    message(FATAL_ERROR "Set REVC_PACKAGE_DIRECTORY to the build/package directory.")
endif()
get_filename_component(_package "${REVC_PACKAGE_DIRECTORY}" ABSOLUTE)
set(_defaults "${CMAKE_CURRENT_LIST_DIR}/package/legacy-asi")
set(_destination "${_package}/legacy-asi")
if(IS_SYMLINK "${_destination}")
    message(FATAL_ERROR "Refusing to stage defaults through a legacy-asi directory symlink: ${_destination}")
endif()
if(EXISTS "${_destination}" AND NOT IS_DIRECTORY "${_destination}")
    message(FATAL_ERROR "legacy-asi exists but is not a directory: ${_destination}")
endif()
foreach(_name README.txt enabled.ini)
    if(NOT EXISTS "${_defaults}/${_name}")
        message(FATAL_ERROR "Missing legacy-ASI package default: ${_defaults}/${_name}")
    endif()
    if(IS_DIRECTORY "${_destination}/${_name}")
        message(FATAL_ERROR "A directory occupies the legacy-ASI default file: ${_destination}/${_name}")
    endif()
endforeach()
file(MAKE_DIRECTORY "${_destination}")
foreach(_name README.txt enabled.ini)
    # A dangling file symlink counts as existing user content too.
    if(NOT EXISTS "${_destination}/${_name}" AND NOT IS_SYMLINK "${_destination}/${_name}")
        configure_file("${_defaults}/${_name}" "${_destination}/${_name}" COPYONLY)
    endif()
endforeach()
