cmake_minimum_required(VERSION 3.14)

set(_helper "${CMAKE_CURRENT_LIST_DIR}/../stage-package.cmake")
set(_templates "${CMAKE_CURRENT_LIST_DIR}/../package/legacy-asi")
if(NOT DEFINED REVC_TEST_DIRECTORY)
    string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef _run)
    get_filename_component(REVC_TEST_DIRECTORY "${CMAKE_CURRENT_LIST_DIR}/../../../build/legacy-asi-package-tests/${_run}" ABSOLUTE)
endif()
if(EXISTS "${REVC_TEST_DIRECTORY}")
    message(FATAL_ERROR "Test directory must be new: ${REVC_TEST_DIRECTORY}")
endif()
file(MAKE_DIRECTORY "${REVC_TEST_DIRECTORY}")

function(_stage directory expected_success)
    execute_process(COMMAND "${CMAKE_COMMAND}" "-DREVC_PACKAGE_DIRECTORY=${directory}" -P "${_helper}"
        RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
    if(expected_success AND NOT result EQUAL 0)
        message(FATAL_ERROR "Staging failed: ${output}${error}")
    elseif(NOT expected_success AND result EQUAL 0)
        message(FATAL_ERROR "Invalid destination was accepted: ${directory}")
    endif()
endfunction()

set(_package "${REVC_TEST_DIRECTORY}/package with spaces")
_stage("${_package}" TRUE)
foreach(_name README.txt enabled.ini)
    file(SHA256 "${_templates}/${_name}" _expected)
    file(SHA256 "${_package}/legacy-asi/${_name}" _actual)
    if(NOT _expected STREQUAL _actual)
        message(FATAL_ERROR "Default ${_name} did not arrive byte-for-byte.")
    endif()
endforeach()
file(READ "${_package}/legacy-asi/enabled.ini" _manifest)
if(_manifest MATCHES "[A-Za-z0-9._-]+[.]asi[ \t]*=")
    message(FATAL_ERROR "The shipped manifest must not enable an ASI.")
endif()

# Deliberately nonempty fixture data; never executed or installed in a game.
file(WRITE "${_package}/legacy-asi/enabled.ini" "[Modules]\nUserFixture.asi=USER_OWNED_CONTENT\n")
file(WRITE "${_package}/legacy-asi/README.txt" "User-owned readme\n")
file(WRITE "${_package}/legacy-asi/user-resource.txt" "User-owned resource\n")
foreach(_name enabled.ini README.txt user-resource.txt)
    file(SHA256 "${_package}/legacy-asi/${_name}" _before_${_name})
endforeach()
_stage("${_package}" TRUE)
foreach(_name enabled.ini README.txt user-resource.txt)
    file(SHA256 "${_package}/legacy-asi/${_name}" _actual)
    if(NOT _before_${_name} STREQUAL _actual)
        message(FATAL_ERROR "Restaging overwrote user content: ${_name}")
    endif()
endforeach()

# Adding a missing default must not overwrite the other, existing file.
set(_partial "${REVC_TEST_DIRECTORY}/partial")
file(MAKE_DIRECTORY "${_partial}/legacy-asi")
file(WRITE "${_partial}/legacy-asi/enabled.ini" "[Modules]\n; Keep this user manifest\n")
file(SHA256 "${_partial}/legacy-asi/enabled.ini" _before)
_stage("${_partial}" TRUE)
file(SHA256 "${_partial}/legacy-asi/enabled.ini" _after)
if(NOT _before STREQUAL _after OR NOT EXISTS "${_partial}/legacy-asi/README.txt")
    message(FATAL_ERROR "Partial staging did not preserve the existing manifest.")
endif()

set(_invalid "${REVC_TEST_DIRECTORY}/invalid")
file(MAKE_DIRECTORY "${_invalid}")
file(WRITE "${_invalid}/legacy-asi" "Not a directory\n")
_stage("${_invalid}" FALSE)
file(READ "${_invalid}/legacy-asi" _unchanged)
if(NOT _unchanged STREQUAL "Not a directory\n")
    message(FATAL_ERROR "Invalid destination was changed.")
endif()
message(STATUS "Legacy-ASI package defaults passed; fixtures retained in ${REVC_TEST_DIRECTORY}")
